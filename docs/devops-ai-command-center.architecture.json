  "cards": [
    {
      "dot": "cyan",
      "title": "Implemented now",
      "items": [
        "React dashboard calls the Express API for incident CRUD/status changes",
        "Socket.IO broadcasts incident:created and incident:updated",
        "Incident service is in-memory; sample logs and sample app tests are fixtures"
      ]
    },
    {
      "dot": "amber",
      "title": "Integration boundaries",
      "items": [
        "Switch adapter fails closed; investigation currently returns 503",
        "Switch API contract must be verified before sending any agent tasks",
        "GitHub API operations are not implemented; credentials are not stored in DB"
      ]
    },
    {
      "dot": "rose",
      "title": "Human safety gate",
      "items": [
        "Target flow: triage → logs → code proposal → isolated tests → human review",
        "Approval/rejection endpoints are currently 501; auth and persistence remain future work",
        "After a recorded approval, GitHub may open a PR; never auto-merge or deploy"
      ]
    }
