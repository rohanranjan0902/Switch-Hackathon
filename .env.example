NODE_ENV=development
API_PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://devops:devops@localhost:5432/devops_command_center?schema=public

# Switch Agent Protocol Integration
# When SWITCH_ENABLED=false, the command center uses the embedded local simulation agent engine.
SWITCH_ENABLED=false
SWITCH_BASE_URL=http://localhost:3000
SWITCH_API_KEY=
SWITCH_AGENT_ID=agent-command-center-01
SWITCH_ROOM_ID=incident-war-room

# GitHub integration boundary (fail-closed until credentials & review are configured)
GITHUB_ENABLED=false
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# Telegram War Room Integration (supports single shared bot token or 4 dedicated agent bot tokens)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_INCIDENT_MANAGER=
TELEGRAM_BOT_TOKEN_LOG_ANALYZER=
TELEGRAM_BOT_TOKEN_CODE_FIXER=
TELEGRAM_BOT_TOKEN_TESTING_AGENT=
TELEGRAM_CHAT_ID=
